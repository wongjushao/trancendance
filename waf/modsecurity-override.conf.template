# Custom ModSecurity overrides for this project.
#
# The OWASP CRS default allowed methods don't include PATCH, which breaks our API
# endpoints that use PATCH for partial updates (e.g. notification preferences).
#
# Limit expanded methods to API routes only.
SecRule REQUEST_URI "@beginsWith /api/" \
  "id:1000001,phase:1,pass,nolog,t:none,setvar:'tx.allowed_methods=GET HEAD POST OPTIONS PUT PATCH DELETE'"
