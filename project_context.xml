            jsonify(
                {
                    "skills": [
                        {
                            "id": skill.id,
                            "name": skill.name,
                        }
                        for skill in skills
                    ]
                }
            ),
            200,
        )
    except SQLAlchemyError as exc:
        return jsonify({"error": str(exc)}), 500
    finally:
        session.close()
