            Learning Path
          </GlowButton>
          <GlowButton size="sm" className="gap-2">
            <FolderOpen className="w-4 h-4" />
            Browse Courses
          </GlowButton>
        </div>
      </div>

      {/* Stats Grid - Today focused */}
      <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
