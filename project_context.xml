  const [notificationPrefs, setNotificationPrefs] = useState<{
    email_enabled: boolean;
    push_enabled: boolean;
    assignment_reminders: boolean;
    course_updates: boolean;
    message_notifications: boolean;
    marketing_emails: boolean;
