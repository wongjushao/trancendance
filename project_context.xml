};

export function getUserRoleData(): RoleData {
  if (typeof window === 'undefined') {
    return defaultRoleData;
  }
  
  const stored = localStorage.getItem(ROLE_STORAGE_KEY);
  if (stored) {
    try {
      const parsed = JSON.parse(stored);
      return {
        ...defaultRoleData,
        ...parsed,
      };
    } catch {
      return defaultRoleData;
    }
  }
  return defaultRoleData;
